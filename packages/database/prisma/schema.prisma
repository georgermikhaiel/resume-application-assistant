generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  SAVED
  PREPARING
  READY_TO_APPLY
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN
  NEEDS_REVIEW
}

enum ArtifactKind {
  RESUME
  COVER_LETTER
  ANSWER_SET
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  FILLED
  SUBMITTED
  BLOCKED
  FAILED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      Profile?
  jobs         Job[]
  applications Application[] 
  auditEvents  AuditEvent[] 
}

model Profile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  fullName              String
  email                 String
  phone                 String?
  location              String?
  workAuthorization     String?
  targetTitles          String[]
  preferredLocations    String[]
  minimumSalary         Int?
  verifiedFacts         Json
  reusableAnswers       Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id              String        @id @default(cuid())
  userId          String
  canonicalUrl    String
  sourceUrl       String
  company         String
  role            String
  location        String?
  description     String
  postedAt        DateTime?
  fitScore        Int?
  fitExplanation  Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications    Application[]
  @@unique([userId, canonicalUrl])
}

model Application {
  id          String            @id @default(cuid())
  userId      String
  jobId       String
  status      ApplicationStatus @default(SAVED)
  createdAt   DateTime          @default(now())
  appliedAt   DateTime?
  notes       String?
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  artifacts   Artifact[]
  executions  FormExecution[]
  @@unique([userId, jobId])
}

model Artifact {
  id              String       @id @default(cuid())
  applicationId   String
  kind            ArtifactKind
  version         Int
  storageKey      String
  contentSnapshot Json
  approvedAt      DateTime?
  createdAt       DateTime     @default(now())
  application     Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@unique([applicationId, kind, version])
}

model FormExecution {
  id              String          @id @default(cuid())
  applicationId   String
  adapter          String
  status           ExecutionStatus @default(QUEUED)
  fieldSnapshot    Json?
  failureReason    String?
  submittedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  application      Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id          String   @id @default(cuid())
  userId      String
  event       String
  entityType  String
  entityId    String
  details     Json
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
